+std::atomic<int> matvec_mode{[]() {
+  const char* value = std::getenv("VLLM_GGUF_MATVEC_MODE");
+  return value && std::strcmp(value, "3") == 0 ? 3 : value && std::strcmp(value, "2") == 0 ? 2 : value && std::strcmp(value, "1") == 0 ? 1 : 0;
+}()};
+int64_t select_matvec_rows(int64_t type, int64_t row, int64_t col) {
+  int64_t launch_rows = 1;
+  if (type == 12 && row == 5120 && col == 6144) launch_rows = 16;
+  if (type == 11 && row == 5120 && col == 17408) launch_rows = 16;
+  if (type == 11 && row == 5120 && col == 6144) launch_rows = 8;
+  if (type == 10 && row == 6144 && col == 5120) launch_rows = 4;
+  if (type == 11 && row == 17408 && col == 5120) launch_rows = 16;
+  if (type == 11 && row == 6144 && col == 5120) launch_rows = 2;
+  if (type == 13 && row == 17408 && col == 5120) launch_rows = 16;
+  if (type == 12 && row == 5120 && col == 17408) launch_rows = 2;
+  return launch_rows;
+}
