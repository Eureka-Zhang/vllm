+Tensor ggml_mul_mat_vec_a8_auto(Tensor W, Tensor X, int64_t type, int64_t row, int64_t variant) {
+  if (X.scalar_type() != ScalarType::BFloat16 || X.sizes()[0] != 1) {
+    return ggml_mul_mat_vec_a8(W, X, type, row);
+  }
+  int64_t col = X.sizes()[1];
+  int64_t launch_rows = 1;
+  if (type == 12 && row == 5120 && col == 6144) launch_rows = 16;
+  if (type == 11 && row == 5120 && col == 17408) launch_rows = 16;
+  if (type == 11 && row == 5120 && col == 6144) launch_rows = 8;
+  if (type == 10 && row == 6144 && col == 5120) launch_rows = 4;
+  if (type == 11 && row == 17408 && col == 5120) launch_rows = 16;
+  if (type == 11 && row == 6144 && col == 5120) launch_rows = 2;
+  if (type == 13 && row == 17408 && col == 5120) launch_rows = 16;
+  if (type == 12 && row == 5120 && col == 17408) launch_rows = 2;
+  if (variant == 2 && (type == 18 || type == 21 || type == 23)) {
+    return ggml_mul_mat_vec_a8_readopt(W, X, type, row, launch_rows);
+  }
+  if (launch_rows != 1) return ggml_mul_mat_vec_a8_tuned(W, X, type, row, launch_rows);
+  return ggml_mul_mat_vec_a8(W, X, type, row);
+}
